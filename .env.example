# Copy to .env and edit. Every value below is a placeholder, not a secret. Keep .env out of git.
# Unset optional variables fall back to the defaults shown.

# --- Required ---------------------------------------------------------------------------------

# Public URL of this provider, as clients see it. Must be a root URL: http(s), no path, no query,
# no fragment (a trailing slash is ignored). This is the OIDC `iss`, so changing it invalidates
# existing tokens and sessions.
ISSUER=https://id.example.com

# Password for the bundled Postgres (docker compose only). Use URL-safe characters, for example
# the output of: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Postgres connection string. docker compose builds this itself from POSTGRES_PASSWORD (and
# ignores a value here). Set it when running without compose or against another database.
# DATABASE_URL=postgres://oidc:change-me@db:5432/oidc

# This provider's own Open Payments wallet address, used to sign requests to auth servers.
OP_WALLET_ADDRESS=https://ilp.interledger-test.dev/your-provider-wallet

# Id of the developer key registered on that wallet address.
OP_KEY_ID=00000000-0000-0000-0000-000000000000

# Path (inside the container) of the Ed25519 private key PEM for OP_KEY_ID. /config is the
# read-only mount of ./config, so put the file at config/op-private-key.pem.
OP_PRIVATE_KEY_PATH=/config/op-private-key.pem

# Comma-separated secrets that sign the OIDC session cookies. The first signs, all verify.
# Generate one with: openssl rand -hex 32
COOKIE_KEYS=change-me-to-a-long-random-string

# --- Optional ---------------------------------------------------------------------------------

# Port to listen on (and publish, with docker compose). Default: 3000
# PORT=3000

# Registered clients (see config/clients.example.json). Default: /config/clients.json
# CLIENTS_FILE=/config/clients.json

# ID token signing keys (see `pnpm -s generate-jwks`). Default: /config/jwks.json
# JWKS_FILE=/config/jwks.json

# Lifetime of the provider's login session and grant, in seconds. Default: 3600
# SESSION_TTL_SECONDS=3600

# Comma-separated origins of the wallet auth servers users may log in through. No paths, no "*".
# Only the auth server is restricted; wallet addresses themselves can be on any host.
# Default: https://auth.interledger-test.dev
# AUTH_SERVER_ALLOWLIST=https://auth.interledger-test.dev

# Allow http:// wallet addresses and auth servers, and skip the private-address check. For local
# development against a local Open Payments setup only, never in production. Default: false
# ALLOW_HTTP=false

# Trust X-Forwarded-For and X-Forwarded-Proto from a reverse proxy. Keep true behind a proxy that
# sets them; set false if clients reach this service directly. Default: true
# TRUST_PROXY=true

# Login submissions and wallet callbacks allowed per client IP per minute, per replica.
# Default: 20
# RATE_LIMIT_PER_MINUTE=20

# Timeout for outbound Open Payments requests, in milliseconds. Default: 5000
# OUTBOUND_TIMEOUT_MS=5000

# --- docker compose only ----------------------------------------------------------------------

# Host directory mounted at /config (read-only). Default: ./config
# CONFIG_DIR=./config

# Env file passed to the oidc service. Default: .env
# ENV_FILE=.env
