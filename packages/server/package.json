{
  "name": "@open-payments-oidc/server",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cozminu/open-payments-oidc.git",
    "directory": "packages/server"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@open-payments-oidc/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "open-payments-oidc": "dist/bin.js",
    "open-payments-oidc-generate-jwks": "dist/generate-jwks.js"
  },
  "dependencies": {
    "@open-payments-oidc/oidc": "workspace:*",
    "@open-payments-oidc/wallet-login": "workspace:*"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "cp ../../LICENSE LICENSE"
  }
}
