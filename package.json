{
  "name": "open-payments-oidc",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Self-hosted OpenID Connect provider that authenticates users with Open Payments wallet addresses",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --conditions=@open-payments-oidc/source packages/server/src/bin.ts",
    "format": "prettier --write .",
    "test": "node --conditions=@open-payments-oidc/source --test 'packages/*/test/**/*.test.ts' 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "generate-jwks": "node --conditions=@open-payments-oidc/source packages/server/src/generate-jwks.ts",
    "sample-client": "node examples/sample-client.ts",
    "build": "pnpm -r build",
    "smoke": "node --conditions=@open-payments-oidc/source scripts/smoke-pack.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^24.19.2",
    "@types/oidc-provider": "^9.13.1",
    "@types/pg": "^8.23.1",
    "openid-client": "^6.8.9",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.23.0"
}
