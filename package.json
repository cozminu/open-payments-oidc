{
  "name": "open-payments-oidc",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Self-hosted OpenID Connect provider that authenticates users with Open Payments wallet addresses",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "format": "prettier --write .",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "generate-jwks": "node src/cli/generate-jwks.ts",
    "sample-client": "node examples/sample-client.ts"
  },
  "dependencies": {
    "@interledger/open-payments": "^7.4.0",
    "oidc-provider": "^9.14.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^24.19.2",
    "@types/oidc-provider": "^9.13.1",
    "@types/pg": "^8.23.1",
    "openid-client": "^6.8.9",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  }
}
